# Required for /prooflab. Keep this server-side; never prefix it with NEXT_PUBLIC_.
OPENAI_API_KEY=

# Build Week requires GPT-5.6. The alias currently routes to GPT-5.6 Sol.
OPENAI_PROOFLAB_MODEL=gpt-5.6

# Existing Diophantix Flask backend used by the solver and explorer.
FLASK_INTERNAL_URL=http://127.0.0.1:5001

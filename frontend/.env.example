# Required for /prooflab. Keep this server-side; never prefix it with NEXT_PUBLIC_.
OPENAI_API_KEY=

# Build Week requires GPT-5.6. The alias currently routes to GPT-5.6 Sol.
OPENAI_PROOFLAB_MODEL=gpt-5.6

# Production request protection. Upstash REST is used across serverless instances;
# without it ProofLab falls back to a process-local limiter for development only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
PROOFLAB_RATE_LIMIT_SALT=
PROOFLAB_REQUEST_LIMIT=12
PROOFLAB_DAILY_REQUEST_LIMIT=750

# Existing Diophantix Flask backend used by the solver and explorer.
FLASK_INTERNAL_URL=http://127.0.0.1:5001
